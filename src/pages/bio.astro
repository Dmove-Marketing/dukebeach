---
import Base from '../layouts/Base.astro';
import config from '../../config.json';
import LeadForm from '../components/forms/LeadForm.astro';
import { getImage } from 'astro:assets';
import rawHero from '../assets/images/bio-hero.jpg';
const heroImage = await getImage({ src: rawHero, format: 'webp' });
import rawDmove from '../assets/images/Versao-Principal-Negativo-scaled-e1750426923582.avif';
const dmoveLogo = await getImage({ src: rawDmove, format: 'avif' });
import rawClientLogo from '../assets/images/Logo_White.png';
const clientLogo = await getImage({ src: rawClientLogo, format: 'webp' });
import '../styles/bio.css';
---

<Base
  title="Duke Beach Hotel & SPA — Destination Wedding · Maresias"
  description="Hotel boutique em Maresias para casamentos privativos. 31 suítes. Um fim de semana inteiramente reservado para um único casal."
  ogImage="/images/og-index.jpg"
>

<!-- HERO IMAGE + TÍTULO -->
  <section class="bio-hero">
    <img src={heroImage.src} alt="Altar decorado com flores brancas e vista para o mar em Maresias" class="bio-hero-img" />
    <div class="bio-hero-overlay"></div>
    <div class="bio-hero-content">
      <span class="bio-brand-sub">Duke Beach Hotel & SPA · Maresias</span>
      <h1 class="bio-headline-pt">Viva um casamento inesquecível<br>em Maresias, no Duke Beach Hotel & SPA.</h1>
      <p class="bio-headline-en">Live an unforgettable wedding in Maresias, at Duke Beach Hotel & SPA.</p>
    </div>
  </section>

<!-- SOBRE NÓS -->
  <section class="bio-about">
    <p class="bio-about-label">Sobre nós</p>
    <a href="https://dukebeacheventos.com.br/" target="_blank" rel="noopener" class="bio-social-btn bio-about-btn">
      Conheça o Duke Beach Hotel & SPA
    </a>
  </section>

<!-- FORM -->
  <section class="form-section" id="solicitar">
    <p class="section-label">Fale conosco</p>

    <LeadForm
      formId="lead-form"
      class="form-card"
      prefix="bio"
      project={config.project_slug}
      submitUrl={config.forms['lead-form'].webhooks[0]}
      redirectUrl={config.forms['lead-form'].redirect_on_success}
      submitText="Solicitar orçamento"
      honeypot
      fields={[
        { name: 'nome', type: 'text', label: 'Nome completo', placeholder: 'Seu nome', required: true, full: true },
        { type: 'row', fields: [
          { name: 'telefone', id: 'whatsapp', type: 'tel', label: 'WhatsApp', placeholder: '(00) 00000-0000', required: true },
          { name: 'email', type: 'email', label: 'E-mail', placeholder: 'seu@email.com', required: true }
        ]},
        { name: 'tipo', type: 'select', label: 'Tipo de evento', placeholder: '', required: true, full: true, options: [
          { value: '', label: 'Tipo de evento' },
          { value: 'Destination Wedding', label: 'Destination Wedding' },
          { value: 'Casamento', label: 'Casamento' },
          { value: 'Festa de recepção', label: 'Festa de recepção' },
          { value: 'Aniversário', label: 'Aniversário' },
          { value: 'Aniversário debutante', label: 'Aniversário debutante' },
          { value: 'Confraternização', label: 'Confraternização' },
          { value: 'Corporativo', label: 'Corporativo' },
          { value: 'Outros', label: 'Outros' }
        ] },
        { type: 'row', fields: [
          { name: 'data', type: 'text', label: 'Data do evento', placeholder: 'dd/mm/aaaa', required: true },
          { name: 'convidados', type: 'number', label: 'Nº de convidados', placeholder: 'Ex: 150', required: true }
        ]},
        { name: 'mensagem', type: 'textarea', label: 'Mensagem', placeholder: 'Detalhes adicionais (não obrigatório)', required: false, full: true }
      ]}
    />
  </section>

<!-- FOOTER -->
  <footer class="bio-footer">
    <div class="bio-footer__top">
      <img src={clientLogo.src} alt="Duke Beach Hotel & SPA" class="bio-footer__client-logo" />
      <div class="bio-footer__social">
        <a href="https://www.facebook.com/dukebeacheventos" target="_blank" rel="noopener" class="bio-social-btn" aria-label="Facebook">
          <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878V14.89h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>
          </svg>
        </a>
        <a href="#" target="_blank" rel="noopener" class="bio-social-btn bio-social-btn--disabled" aria-label="TikTok" aria-disabled="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.28 8.28 0 0 0 4.84 1.54V6.78a4.85 4.85 0 0 1-1.07-.09z"/>
          </svg>
        </a>
        <a href="#" target="_blank" rel="noopener" class="bio-social-btn bio-social-btn--disabled" aria-label="Pinterest" aria-disabled="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12.017 24c6.624 0 11.99-5.367 11.99-11.988C24.007 5.367 18.641.001 12.017.001z"/>
          </svg>
        </a>
      </div>
    </div>
    <div class="footer__bottom">
      <p class="footer__copy">&copy; 2026 Duke Beach. Todos os direitos reservados.</p>
      <a href="https://dmove.com.br/" target="_blank" rel="noopener noreferrer" class="footer__dmove">
        Desenvolvido por
        <img src={dmoveLogo.src} alt="Dmove" class="footer__dmove-logo" width="60" height="14" />
      </a>
    </div>
  </footer>

</Base>

<script>
  import '../scripts/bio.js';
</script>
